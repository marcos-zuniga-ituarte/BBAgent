# BBAgent — configuracion publica del frontend
# Desarrollo: copia este archivo a .env.local dentro de frontend/.
# Reinicia Vite tras cambiarlo. Para una compilacion estatica, los valores se
# incorporan al JavaScript durante npm run build; despues hay que recompilar.
# No incluyas secretos: todas las variables VITE_* son visibles en el navegador.

# URL base de la API, accesible desde el navegador, sin barra final ni /docs.
# Local: http://localhost:8000
# Otro servidor: https://api.example.com
# En Docker, localhost es el ordenador donde se abre el navegador, no el contenedor.
# Si no se define, la aplicacion utiliza http://localhost:8000.
VITE_API_BASE_URL=http://localhost:8000

# OPENAI_API_KEY pertenece exclusivamente a backend/.env. No se configura aqui.
# Esta es la unica variable de entorno que consume actualmente el frontend.
