# BBAgent — configuracion del backend
# Copia este archivo a .env dentro de backend/ y adapta los valores.
# No sobrescribas un .env existente sin revisar su configuracion.
# Ejecuta la API y la CLI desde backend/. Las variables del sistema tienen
# prioridad sobre .env. Nunca publiques tu .env ni una clave real.

# -----------------------------------------------------------------------------
# 1. Autenticacion con OpenAI (obligatoria para usar el agente)
# -----------------------------------------------------------------------------
# Sustituye este marcador por una clave propia vigente. No es una clave real.
# La CLI de usuarios no necesita esta clave; las llamadas al modelo si.
OPENAI_API_KEY=replace-with-your-openai-api-key

# -----------------------------------------------------------------------------
# 2. Persistencia local
# -----------------------------------------------------------------------------
# Archivo SQLite, no una URL de conexion. Relativo a backend/ o ruta absoluta.
# El directorio se crea automaticamente. Usa otra ruta para otra base de datos.
# Compose global reemplaza este valor por /app/data/bd/local.db dentro del contenedor.
DATABASE_PATH=data/bd/local.db

# -----------------------------------------------------------------------------
# 3. Modelos
# -----------------------------------------------------------------------------
# Identificadores de modelo: ajustalos a los disponibles para tu cuenta.
# Los valores siguientes conservan la configuracion del proyecto original.
# Agente principal: respuestas, streaming y llamadas a herramientas.
OPENAI_AGENT_MODEL=gpt-5.4-mini
# Transcripcion de audio enviado por el usuario.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
# Actualizacion y reconstruccion de la memoria de conversacion.
OPENAI_MEMORY_MODEL=gpt-5.4-nano

# -----------------------------------------------------------------------------
# 4. Contexto y presentacion
# -----------------------------------------------------------------------------
# Numero entero >= 0 de turnos historicos que se conservan junto al turno actual.
# Un turno agrupa un mensaje de usuario y sus respuestas posteriores.
# 0 excluye los turnos historicos de esta ventana; no borra mensajes de SQLite.
CONTEXT_HISTORY_RUNS=3
# Maximo de caracteres del titulo inicial, tomado del texto del primer mensaje.
# Usa un entero positivo.
CHAT_TITLE_MAX_LENGTH=20

# -----------------------------------------------------------------------------
# 5. Herramienta de terminal
# -----------------------------------------------------------------------------
# Segundos sin salida antes de devolver el resultado de un comando.
# Usa un numero positivo; admite decimales. El cliente aplica su limite propio.
TERMINAL_IDLE_TIMEOUT_SECONDS=2.0

# -----------------------------------------------------------------------------
# 6. Prompts
# -----------------------------------------------------------------------------
# Nombre del archivo en data/prompts/, sin ruta ni extension .txt.
# Para personalizarlo, crea primero el archivo correspondiente.
# Instrucciones del agente principal.
AGENT_PROMPT=terminal_speaking
# Instrucciones para actualizar la memoria.
MEMORY_PROMPT=memory
# Instrucciones para reconstruir la memoria completa.
MEMORY_PROMPT_FULL_REBUILD=memory_recover

# -----------------------------------------------------------------------------
# 7. Origenes web permitidos (CORS)
# -----------------------------------------------------------------------------
# Origenes separados por comas, sin rutas. No uses *.
# Incluye la URL donde abres el frontend, no la URL del backend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
